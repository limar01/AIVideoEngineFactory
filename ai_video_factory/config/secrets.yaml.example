# AI Video Factory — Secrets Configuration
#
# COPY THIS FILE TO secrets.yaml AND FILL IN VALUES
# NEVER COMMIT secrets.yaml (it is gitignored)
#
# SnapGen session (cookie-based; populated by browser automation after user auth)
snapgen:
  session_cookies: {}  # populated at runtime; never hand-written

# Optional: LLM API keys (only needed if story.engine != hermes)
openai:
  api_key: ""

gemini:
  api_key: ""

# Optional: TTS API keys (only needed if audio.provider != piper/silent)
elevenlabs:
  api_key: ""
