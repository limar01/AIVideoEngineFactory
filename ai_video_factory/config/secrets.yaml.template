# secrets.yaml — PLACEHOLDER (do NOT commit real values)
# Copy to config/secrets.yaml and fill in.
# Run: aivf init  OR  python -c "from app.core.security import generate_encryption_key; print(generate_encryption_key())"

security:
  encryption_key: ""  # Fernet key for encrypting account credentials at rest

providers:
  snapgen:
    # Set via CDP auth flow — the system captures Google OAuth session cookies
    # Do NOT hard-code credentials here. Use the auth flow instead.
    session_file: ".sessions/snapgen.json"

api:
  key: ""  # Optional API key for REST API access (if not using localhost only)
