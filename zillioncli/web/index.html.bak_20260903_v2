/* Local CLI Executor */
async function runLocal(cmdStr){
  cmdStr = cmdStr.trim(); if(!cmdStr) return;
  if(cmdStr === 'clear'){ clear(); return; }
  if(cmdStr === 'restore' || cmdStr === 'zion-restore'){ triggerRestore(); return; }
  cmdLine(cmdStr); busy = true; goEl.disabled = true;
  const st = Date.now();
  try{
    const r = await api('/api/cmd', {cmd: cmdStr});
    if(r.limiter_pct !== undefined){ updateLimiterUI(r.limiter_pct, true); }
    if(r.error){ line(r.error, 'err'); }
    else if(r.output && r.output.trim()){
      r.output.trim().split('\n').forEach(ln=>{ let cls='';
        if(/✓/.test(ln)) cls='ok'; else if(/✗|error|traceback|denied|not found/i.test(ln)) cls='err';
        else if(/WARNING|HTTP 4|HTTP 5|timeout/i.test(ln)) cls='warn'; line(ln, cls); });
    } else line('(no output)', 'dim');
  }catch(e){ line('request failed: ' + e.message, 'err'); }
  busy = false; goEl.disabled = false; pingEl.textContent = 'done in ' + ((Date.now()-st)/1000).toFixed(1) + 's';
  outEl.scrollTop = outEl.scrollHeight;
}

/* Agent Send */
async function runSend(text){
  text = text.trim();
  if(!text && !attachments.length){ return; }
  cmdLine(text || '(attachment)');
  busy = true; goEl.disabled = true;
  const st = Date.now();
  try{
    const r = await api('/api/cmd', {cmd: 'zion', text: text});
    if(r.limiter_pct !== undefined){ updateLimiterUI(r.limiter_pct, true); }
    if(r.error){ line('✗ ' + r.error, 'err'); }
    else{
      if(r.session){ cidEl.textContent = r.session.slice(0,13); }
      line('━━━ AI RESPONSE ━━━', 'warn');
      if(r.output && r.output.trim()){ line(r.output.trim(), 'ok'); }
      else line('(walang response pa)', 'dim');
    }
  }catch(e){ line('✗ request failed: ' + e.message, 'err'); }
  busy = false; goEl.disabled = false;
  pingEl.textContent = 'done in ' + ((Date.now()-st)/1000).toFixed(1) + 's';
  attachments = []; renderAttach();
  outEl.scrollTop = outEl.scrollHeight;
}

function submitCmd(v){
  v = (v || '').trim(); if(!v) return;
  if(history.indexOf(v) !== -1) history.splice(history.indexOf(v), 1);
  history.unshift(v); hix = -1;
  const looksCli = /^(status|ls|open|help|zion|save|clear|me|whoami|login|signup|logout|signout|autoheal|restore)(\s|$)/.test(v) || v === 'clear';
  if(looksCli) runLocal(v); else runSend(v);
}

document.querySelectorAll('.btn[data-c]').forEach(b=>{
  b.addEventListener('click', ()=>{ const c = b.getAttribute('data-c'); if(c === ''){ clear(); return; } submitCmd(c); });
});

/* Multi-line keyboard event listener */
cmdEl.addEventListener('keydown', e=>{
  if(e.key === 'Enter' && !e.shiftKey){
    // If Enter without shift, submit command/prompt
    e.preventDefault();
    submitCmd(cmdEl.value);
    cmdEl.value = '';
  }
  else if(e.key === 'ArrowUp' && cmdEl.value === ''){
    e.preventDefault();
    if(history.length){ hix = hix < 0 ? history.length-1 : Math.max(0, hix-1); cmdEl.value = history[hix] || ''; }
  }
  else if(e.key === 'ArrowDown' && hix >= 0){
    e.preventDefault();
    hix++;
    if(hix >= history.length){ hix = history.length; cmdEl.value = ''; }
    else cmdEl.value = history[hix];
  }
});

goEl.addEventListener('click', ()=>{ submitCmd(cmdEl.value); cmdEl.value = ''; });
btnClearIn.addEventListener('click', ()=>{ cmdEl.value = ''; cmdEl.focus(); });

banner(); refreshStatus(); setInterval(refreshStatus, 8000);
