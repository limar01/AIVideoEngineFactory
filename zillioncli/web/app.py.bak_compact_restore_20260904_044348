# ---------- CDP helpers (arena-tab aware) ----------

def _list_tabs():
    try:
        req = urllib.request.urlopen(f"{CDP_URL}/json", timeout=3)
        return json.loads(req.read())
    except Exception:
        return []

def probe_online():
    try:
        req = urllib.request.urlopen(f"{CDP_URL}/json/version", timeout=2)
        return bool(req.read())
    except Exception:
        return False

def _page_ws(match_arena=False):
    tabs = _list_tabs()
    for t in tabs:
        if t.get("type") != "page":
            continue
        if match_arena and ARENA_HOST_HINT not in (t.get("url") or ""):
            continue
        if "webSocketDebuggerUrl" in t:
            return t["webSocketDebuggerUrl"]
    return None

def _cdp_eval(expr, ws_url=None, match_arena=False, timeout=6, await_promise=True):
    """Evaluate JS on the arena.ai page tab (or any page tab if match_arena=False)."""
    try:
        ws_url = ws_url or _page_ws(match_arena=match_arena)
        if not ws_url:
            return None
        ws = websocket.create_connection(ws_url, timeout=timeout)
        msg = {"id": 1, "method": "Runtime.evaluate",
               "params": {"expression": expr, "returnByValue": True, "awaitPromise": await_promise}}
        ws.send(json.dumps(msg))
        val = None
        t0 = time.time()
        while time.time() - t0 < timeout:
            try:
                res = json.loads(ws.recv())
            except Exception:
                break
            if res.get("id") == 1:
                val = res.get("result", {}).get("result", {}).get("value")
                break
        try:
            ws.close()
        except Exception:
            pass
        return val
    except Exception:
        return None

def _ensure_arena_tab():
    """Return arena page ws; if none exists, navigate an existing page tab to arena."""
    ws_url = _page_ws(match_arena=True)
    if ws_url:
        return ws_url
    ws_url = _page_ws(match_arena=False)
    if not ws_url:
        return None
    _cdp_eval(f"window.location.href = {json.dumps(ARENA_HOME)}", ws_url=ws_url, timeout=4)
    time.sleep(2.5)
    return _page_ws(match_arena=True)

ME_EXPR = (
    "(async()=>{try{const r=await fetch('/api/me',{headers:{accept:'application/json'}});"
    "const d=await r.json().catch(()=>({}));return {status:r.status,user:(d&&d.user)||null};}"
    "catch(e){return {status:0,error:String(e)}}})()"
)

def _mask_session(s):
    """Never leak raw tokens/cookies to HTTP responses (SEC-1 fix)."""
    if not isinstance(s, dict):
        return {}
    return {
        "has_token": bool(s.get("session_token")),
        "email": s.get("email"),
        "count": s.get("count", len(s.get("cookies") or [])),
        "updated_at": s.get("updated_at"),
        "source": s.get("source"),
    }

# ---------- CLI runner (SEC-2 fix: strict allowlist only) ----------

def run_cmd(args, timeout=60):
    if not args:
        return {"error": "no command", "exit_code": 1}
    first = os.path.basename(args[0])
    if first not in CMD_MAP:
        return {"error": f"not allowed: {first}", "exit_code": 1}

    mapped = CMD_MAP.get(first, first)
    if first == "help":
        args = [ZION]
    else:
        args[0] = os.path.expanduser("~/.local/bin/" + mapped)

    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout,
                           cwd=os.path.expanduser("~/.local/bin"))
        out = (p.stdout or "")
        if p.stderr:
            out += ("\n" + p.stderr)
        return {"output": out[-20000:], "exit_code": p.returncode}
    except subprocess.TimeoutExpired:
        return {"error": f"timeout after {timeout}s", "exit_code": -1}
    except Exception as e:
        return {"error": str(e), "exit_code": -1}

# ---------- Session capture & auth state ----------

def _ws_cmd(ws, mid, method, params=None, timeout=6):
    ws.send(json.dumps({"id": mid, "method": method, "params": params or {}}))
    t0 = time.time()
    while time.time() - t0 < timeout:
        try:
            res = json.loads(ws.recv())
        except Exception:
            return {}
        if res.get("id") == mid:
            return res
    return {}

def _pick_auth_token(cookies):
    by_name = {}
    for c in cookies:
        n = c.get("name") or ""
        if n not in by_name:
            by_name[n] = c.get("value")
    for n, v in by_name.items():
        if any(n.startswith(p) for p in AUTH_COOKIE_PREFIX) and v:
            return v
    for n in AUTH_COOKIE_NAMES:
        if by_name.get(n):
            return by_name[n]
    return None

def capture_cookies_from_browser(ws_url=None, email=None):
    """Sync the probe browser's arena.ai session cookies into session.json + CLI cookie files."""
    try:
        ws_url = ws_url or _page_ws(match_arena=True)
        if not ws_url:
            return {"ok": False, "error": "No arena.ai page tab found on probe CDP (port 9222)"}
        ws = websocket.create_connection(ws_url, timeout=6)
        _ws_cmd(ws, 1, "Network.enable")
        res = _ws_cmd(ws, 2, "Network.getCookies", {"urls": ["https://arena.ai", "https://www.arena.ai"]})
        try:
            ws.close()
        except Exception:
            pass
        cookies = res.get("result", {}).get("cookies", [])
        arena_c = [c for c in cookies if "arena.ai" in (c.get("domain") or "")]
        session_token = _pick_auth_token(arena_c or cookies)
        blob = ", ".join(
            f"{c['name']}={c['value']}" for c in (arena_c or cookies)
            if c.get("name") and c.get("value")
        )
        os.makedirs(os.path.dirname(SESSION_FILE), exist_ok=True)
        session_data = {
            "session_token": session_token,
            "email": email,
            "cookies": arena_c or cookies,
            "count": len(arena_c or cookies),
            "source": "probe_cdp_auto",
            "updated_at": time.strftime("%Y-%m-%d %H:%M:%S")
        }
        with open(SESSION_FILE, "w") as f:
            json.dump(session_data, f, indent=2)
        try:
            os.chmod(SESSION_FILE, 0o600)
        except Exception:
            pass
        if blob:
            for path in COOKIE_FILES:
                try:
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    with open(path, "w") as fh:
                        fh.write(blob)
                    os.chmod(path, 0o600)
                except Exception:
                    pass
        return {"ok": True, "count": len(arena_c or cookies), "cookies_count": len(arena_c or cookies),
                "has_token": bool(session_token), "email": email}
    except Exception as e:
        return {"ok": False, "error": str(e)}

def auth_state(sync=True):
    """BOSS RULE #1: whatever account is logged in on the probe browser = the session to use."""
    st = {"ok": True, "probeOnline": probe_online(), "loggedIn": False, "user": None, "url": None}
    if not st["probeOnline"]:
        st["ok"] = False
        st["error"] = "probe browser offline"
        return st
    ws_url = _page_ws(match_arena=True)
    if not ws_url:
        ws_url = _ensure_arena_tab()
    if not ws_url:
        st["error"] = "no arena.ai tab in probe browser"
        return st
    st["url"] = _cdp_eval("window.location.href", ws_url=ws_url, await_promise=False)
    me = _cdp_eval(ME_EXPR, ws_url=ws_url)
    if (isinstance(me, dict) and me.get("status") == 200
            and isinstance(me.get("user"), dict) and me["user"].get("email")):
        st["loggedIn"] = True
        st["user"] = {
            "email": me["user"].get("email"),
            "username": me["user"].get("username"),
            "id": me["user"].get("id"),
        }
        if sync:
            cap = capture_cookies_from_browser(ws_url=ws_url, email=st["user"]["email"])
            st["captured"] = cap.get("count", 0) if cap.get("ok") else 0
    return st

# ---------- Auto-heal / restore flows (unchanged) ----------

def execute_autoheal_flow():
    try:
        import autoheal
        res = autoheal.run_autoheal()
        GLOBAL_STATE["limiter_pct"] = 0
        GLOBAL_STATE["autoheal_history"].append(res)
        return {"ok": True, "res": res, "limiter_pct": 0}
    except Exception as e:
        res = run_cmd(["zion-autoheal"])
        GLOBAL_STATE["limiter_pct"] = 0
        return {"ok": True, "output": res, "limiter_pct": 0}

def execute_restore_flow():
    try:
        import restore_engine
        res = restore_engine.run_auto_restore()
        return {"ok": True, "restore": res}
    except Exception as e:
        return {"ok": False, "error": str(e)}

# ---------- HTTP handler ----------

class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=STATIC_DIR, **kwargs)

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        if u.path == "/api/status":
            session_info = {}
            if os.path.exists(SESSION_FILE):
                try:
                    with open(SESSION_FILE) as f:
                        session_info = _mask_session(json.load(f))
                except Exception:
                    pass
            self._json({
                "status": "ok",
                "cdp": probe_online(),
                "session": session_info,
                "limiter_pct": GLOBAL_STATE["limiter_pct"]
            })
        elif u.path == "/api/limiter":
            self._json({"ok": True, "limiter_pct": GLOBAL_STATE["limiter_pct"]})
        elif u.path in ("/api/me", "/api/whoami"):
            res = run_cmd(["whoami"])
            self._json(res)
        elif u.path == "/api/auth/state":
            self._json(auth_state(sync=True))
        elif u.path == "/api/auth/poll":
            st = auth_state(sync=True)
            self._json({
                "ok": True,
                "probeOnline": st["probeOnline"],
                "loggedIn": st["loggedIn"],
                "user": st["user"] or {},
                "url": st["url"]
            })
        elif u.path == "/api/autoheal":
            res = execute_autoheal_flow()
            self._json(res)
        elif u.path == "/api/restore":
            res = execute_restore_flow()
            self._json(res)
        else:
            super().do_GET()

    def do_POST(self):
        u = urllib.parse.urlparse(self.path)
        len_h = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(len_h) if len_h else b"{}"
        try:
            data = json.loads(body) if body else {}
        except Exception as e:
            self._json({"ok": False, "error": "Invalid JSON body: " + str(e), "exit_code": 1})
            return

        if u.path == "/api/restore/chat":
            try:
                text = (data.get("text") or "").strip().lower()
                atts = data.get("attachments") or []
                import base64 as _b64
                lane = None
                if "zillionom" in text: lane = "pc"
                elif "zillioncp" in text: lane = "cp"
                elif "zillionwin" in text: lane = "win"
                mem = None
                for a in atts:
                    fn = (a.get("filename") or "").lower()
                    du = a.get("dataUrl") or ""
                    if fn.endswith(".md") and "," in du:
                        try: mem = _b64.b64decode(du.split(",",1)[1]+"===").decode("utf-8","replace")
                        except Exception: mem = None
                        if mem and ("ZILLION_KEY_BEGIN" in mem or "MEMORY_CORE" in mem[:200]): break
                lines = []
                log = lines.append
                log("")
                log("\u26a1 ZILLION RESTORE PROTOCOL v6.1")
                log("  Token: " + (text or "(none)") + "  \u2192 lane " + (lane or "?"))
                log("")
                if not lane:
                    log("\u274c Walang valid token (zillionOM / zillionCp / zillionWin). Halt.")
                    self._json({"ok":False,"output":"\n".join(lines),"exit_code":1}); return
                if not mem:
                    log("\u26a0\ufe0f  Walang naka-attach na MEMORY_CORE.md. I-attach ang file kasama ang token.")
                    self._json({"ok":False,"output":"\n".join(lines),"exit_code":1}); return
                km = re.search(r"ZILLION_KEY_BEGIN\s*\n([A-Za-z0-9_\-]+)\nZILLION_KEY_END", mem)
                key = km.group(1).strip() if km else None
                if not key:
                    log("\u274c Walang ZILLION_KEY block sa attachment.")
                    self._json({"ok":False,"output":"\n".join(lines),"exit_code":1}); return
                kp = os.path.expanduser("~/arenabridge/arenabridge.key")
                os.makedirs(os.path.dirname(kp), exist_ok=True)
                with open(kp,"w") as f: f.write(key)
                os.chmod(kp,0o600)
                log(f"\u2714 Key extracted \u2192 {kp} (0o600, {len(key)} B)")
                has_grim = subprocess.run(["bash","-lc","command -v grim >/dev/null 2>&1"]).returncode==0
                eyes = "DIRECT" if has_grim else "JAXVL?"
                log(f"\u2714 Vision probe: {eyes}")
                log("")
                log("→ Handoff sa Arena cloud agent (one-shot restored chat)...")
                # BUGFIX: zion-send creates a NEW Arena chat per call; chunking splits memory across chats.
                # Send one full restore payload in a temp file via zion-send @file so the memory/key is not exposed in ps argv.
                import tempfile
                zs = os.path.expanduser("~/.local/bin/zion-send")
                restore_prompt = (text or "") + chr(10) +                     "[MEMORY_CORE FULL - restore from this attached core now]" + chr(10) + mem + chr(10) +                     "[RESTORE VERIFICATION REQUIRED] Reply with: RESTORED_OK target=<target> static_ip=<ip> steps=<count> chain=<short chain>."
                log("")
                log("→ One-shot MEMORY_CORE delivery sa Arena: %d chars (single chat context)" % len(restore_prompt))
                tmp_path = None
                try:
                    with tempfile.NamedTemporaryFile("w", delete=False, encoding="utf-8", prefix="zillion_restore_", suffix=".txt") as tf:
                        tf.write(restore_prompt)
                        tmp_path = tf.name
                    rr = run_cmd([zs, "@" + tmp_path], timeout=180)
                finally:
                    try:
                        if tmp_path and os.path.exists(tmp_path): os.remove(tmp_path)
                    except Exception:
                        pass
                log("  • one-shot restore send done (exit %s)" % rr.get("exit_code"))
                out = rr.get("output") or rr.get("stderr") or ""
                if rr.get("exit_code") != 0:
                    log("❌ One-shot restore failed.")
                for ln2 in out.split(chr(10)):
                    if ln2.strip():
                        log("  " + ln2)

                self._json({"ok":True,"output":"\n".join(lines),"lane":lane,"eyes":eyes,"handoff":True,"exit_code":0})
            except Exception as e:
                import traceback
                self._json({"ok":False,"output":f"\u274c Restore handler crashed: {e}\n{traceback.format_exc()}","exit_code":1})
            return

        elif u.path == "/api/upload":
            try:
                import base64 as _b64
                up = os.path.expanduser("~/.zion/uploads")
                os.makedirs(up, exist_ok=True)
                sd = os.path.join(up, time.strftime("%Y%m%d_%H%M%S"))
                os.makedirs(sd, exist_ok=True)
                saved = []
                for f in (data.get("files") or []):
                    fn = os.path.basename(f.get("filename","file"))
                    du = f.get("dataUrl","")
                    if "," in du:
                        try:
                            raw = _b64.b64decode(du.split(",",1)[1]+"===")
                            p = os.path.join(sd, fn)
                            with open(p,"wb") as fh: fh.write(raw)
                            saved.append({"filename":fn,"path":p,"size":len(raw)})
                        except Exception as e:
                            saved.append({"filename":fn,"error":str(e)})
                self._json({"ok":True,"dir":sd,"files":saved})
            except Exception as e:
                self._json({"ok":False,"error":str(e)})

        elif u.path == "/api/logout":
            r = run_cmd(["signout"])
            if r.get("exit_code") == 0:
                # BUG-7b fix 2026-09-04: clear probe cookies para walang re-sync
                try:
                    _wsu = _ensure_arena_tab()
                    if _wsu:
                        import websocket as _wsw
                        _w = _wsw.create_connection(_wsu, timeout=6, suppress_origin=True)
                        _ws_cmd(_w, 91, "Network.clearBrowserCookies", {})
                        _w.close()
                except Exception:
                    pass
                # BUG-7 fix 2026-09-04: i-clear rin ang hub session stores para tumugma ang /api/status
                try:
                    with open(SESSION_FILE, "w") as f:
                        json.dump({}, f)
                except Exception:
                    pass
                for cand in SESSION_CANDIDATES:
                    try:
                        if os.path.exists(cand):
                            open(cand, "w").write("")
                    except Exception:
                        pass
            else:
                # BUG-7c fix 2026-09-04: kahit mabigo ang zion signout (hal. probe offline), i-clear pa rin ang local stores
                try:
                    with open(SESSION_FILE, "w") as f:
                        json.dump({}, f)
                    for cand in SESSION_CANDIDATES:
                        if os.path.exists(cand):
                            open(cand, "w").write("")
                    r = dict(r or {})
                    r["local_cleared"] = True
                except Exception:
                    pass
            self._json(r)

        elif u.path == "/api/send-cancel":
            # No real sub-process cancel yet (zion-send uses CDP); we just acknowledge so UI can reset.
            self._json({"ok":True,"cancelled":True})

        if u.path == "/api/cmd":
            cmd = data.get("cmd", "")
            text = data.get("text", "")
            atts = data.get("attachments") or []
            att_note = ""
            mem_chunks = []  # BUGFIX: /api/cmd with no attachments must not crash before first_text check
            if atts:
                names = [os.path.basename(a.get("filename","")) for a in atts]
                mem_chunks = []
                if text and ("restore" in text.lower() or "zillionom" in text.lower()):
                    for a in atts:
                        fnx = (a.get("filename") or "")
                        dux = (a.get("dataUrl") or a.get("data") or "")
                        if fnx.endswith(".md") and "," in dux:
                            try:
                                memx = __import__("base64").b64decode(dux.split(",", 1)[1] + "===").decode("utf-8", "replace")
                                if "MEMORY_CORE" in memx[:200] or "ZILLION_KEY_BEGIN" in memx:
                                    mem_chunks = [memx[k:k+5000] for k in range(0, min(len(memx), 40000), 5000)]
                                    break
                            except Exception:
                                pass
                mem_inline = ""
                att_note = "\n[attachments: " + ", ".join(names) + "]"
            if text:
                # Shorter timeout for send so UI doesn't hang 60s
                first_text = text
                if mem_chunks:
                    n = len(mem_chunks)
                    first_text = text + chr(10) + "[MEMORY_CORE part 1/%d]" % n + chr(10) + mem_chunks[0]
                args = [os.path.expanduser("~/.local/bin/zion-send"), first_text]
                res = run_cmd(args, timeout=60)
                # BUG-15 fix 2026-09-04: chunked delivery ng MEMORY_CORE (<=5KB bawat arena message)
                if mem_chunks and res.get("exit_code") == 0:
                    extra = []
                    for ci in range(1, len(mem_chunks)):
                        pt = "[MEMORY_CORE part %d/%d]" % (ci + 1, len(mem_chunks)) + chr(10) + mem_chunks[ci]
                        r2c = run_cmd([os.path.expanduser("~/.local/bin/zion-send"), pt], timeout=45)
                        extra.append((r2c.get("output") or "").strip())
                    rf = run_cmd([os.path.expanduser("~/.local/bin/zion-send"),
                                  "[MEMORY_CORE delivery complete: %d parts] Reply in one line: RECEIVED n/N sections visible." % len(mem_chunks)], timeout=45)
                    extra.append((rf.get("output") or "").strip())
                    res = dict(res)
                    res["output"] = (res.get("output") or "") + chr(10) + chr(10).join(extra)
            elif isinstance(cmd, str):
                args = cmd.strip().split()
                res = run_cmd(args, timeout=60)
            else:
                args = cmd
                res = run_cmd(args, timeout=60)
            if att_note and "output" in res:
                res["output"] = att_note + "\n" + (res.get("output") or "")
            # Friendly timeout message
            if res.get("error") == "timeout":
                res["output"] = (res.get("output") or "") + "\n\u23f1 Nag-timeout ang request (60s). Pwedeng subukan ulit o i-check ang probe browser (zion status)."
                res["cancellable"] = True
            GLOBAL_STATE["limiter_pct"] = min(100, GLOBAL_STATE["limiter_pct"] + 2)
            res["limiter_pct"] = GLOBAL_STATE["limiter_pct"]
            self._json(res)
        elif u.path == "/api/limiter/set":
            val = int(data.get("pct", 92))
            GLOBAL_STATE["limiter_pct"] = max(0, min(100, val))
            self._json({"ok": True, "limiter_pct": GLOBAL_STATE["limiter_pct"]})
        elif u.path == "/api/probe/ensure":
            script = os.path.join(ZION_TOOL_DIR, "probe_browser.sh")
            try:
                p = subprocess.run(["bash", script, "ensure"], capture_output=True, text=True, timeout=30)
                online = probe_online()
                self._json({"ok": online, "probeOnline": online,
                            "detail": ((p.stdout or "") + (p.stderr or "")).strip()[-300:]})
            except Exception as e:
                self._json({"ok": False, "probeOnline": probe_online(), "error": str(e)})
        elif u.path == "/api/autoheal":
            res = execute_autoheal_flow()
            self._json(res)
        elif u.path == "/api/restore":
            res = execute_restore_flow()
            self._json(res)
        elif u.path in ("/api/auth/save-session", "/api/capture"):
            st = auth_state(sync=True)
            res = capture_cookies_from_browser(email=(st.get("user") or {}).get("email"))
            self._json(res)
        elif u.path == "/api/login":
            ws_url = _ensure_arena_tab()
            if ws_url:
                _cdp_eval("window.location.href = 'https://arena.ai/sign-in'", ws_url=ws_url, await_promise=False)
                self._json({"ok": True, "message": "Sign-in page opened in probe browser"})
            else:
                self._json({"ok": False, "error": "Probe browser offline or no page tab"})
        elif u.path == "/api/auth/login-direct":
            email = data.get("email", "").strip()
            password = data.get("password", "").strip()
            if not email or not password:
                self._json({"ok": False, "error": "Email and password required"})
                return
            ws_url = _ensure_arena_tab()
            if not ws_url:
                self._json({"ok": False, "error": "Probe browser offline — possible hindi ma-login"})
                return
            eval_code = f"""
            (async () => {{
                try {{
                    const res = await fetch('/nextjs-api/sign-in/email', {{
                        method: 'POST',
                        headers: {{ 'Content-Type': 'application/json' }},
                        body: JSON.stringify({{ email: {json.dumps(email)}, password: {json.dumps(password)} }})
                    }});
                    const d = await res.json().catch(() => ({{}}));
                    return {{ status: res.status, ok: res.ok, data: d }};
                }} catch (err) {{
                    return {{ ok: false, error: err.toString() }};
                }}
            }})()
            """
            res = _cdp_eval(eval_code, ws_url=ws_url, timeout=15) or {}
            # BUG-13 fix 2026-09-04: navigation hiwalay sa ina-await na promise (iwas hang/ANR/latency)
            if bool(res.get("ok", False) or res.get("status") in (200, 201)):
                _cdp_eval("window.location.href = " + json.dumps(ARENA_HOME), ws_url=ws_url, await_promise=False)
            time.sleep(2)
            me = _cdp_eval(ME_EXPR) or {}
            me_ok = bool(isinstance(me, dict) and me.get("status") == 200
                         and isinstance(me.get("user"), dict) and me["user"].get("email"))
            cap = capture_cookies_from_browser(email=email)
            cred_ok = bool(res.get("ok", False) or res.get("status") in (200, 201))
            ok = cred_ok

            err = res.get("data", {}).get("message") or res.get("data", {}).get("error") or res.get("error")
            if not ok and me_ok:
                err = err or ("Credential login FAILED; probe session still active (%s) - submitted credentials hindi ginamit." % ((me.get("user") or {}).get("email")))
            if ok:
                execute_restore_flow()
            real_email = (me.get("user") or {}).get("email") if me_ok else email
            self._json({"ok": ok, "user": {"email": real_email, "username": (me.get("user") or {}).get("username") if me_ok else None},
                        "error": err or ("Login failed" if not ok else None), "raw": res, "captured": cap})
        elif u.path == "/api/auth/signup-magic":
            email = data.get("email", "").strip()
            if not email:
                self._json({"ok": False, "error": "Email required"})
                return
            ws_url = _ensure_arena_tab()
            if not ws_url:
                self._json({"ok": False, "error": "Probe browser offline"})
                return
            eval_code = f"""
            (async () => {{
                try {{
                    const res = await fetch('/nextjs-api/sign-up/magic-link', {{
                        method: 'POST',
                        headers: {{ 'Content-Type': 'application/json' }},
                        body: JSON.stringify({{ email: {json.dumps(email)} }})
                    }});
                    const d = await res.json().catch(() => ({{}}));
                    return {{ status: res.status, ok: res.ok, data: d }};
                }} catch (err) {{
                    return {{ ok: false, error: err.toString() }};
                }}
            }})()
            """
            res = _cdp_eval(eval_code, ws_url=ws_url, timeout=15) or {}
            ok = res.get("ok", False) or res.get("status") in (200, 201)
            self._json({"ok": ok, "message": res.get("data", {}).get("message") or ("Magic link sent to " + email),
                        "error": (res.get("data", {}).get("message") or res.get("data", {}).get("error") or res.get("error")) if not ok else None})
        else:
            self.send_response(404)
            self.end_headers()

    def _json(self, payload):
        b = json.dumps(payload).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

