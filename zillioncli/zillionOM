# CLI args parser
def parse_args():
    args = sys.argv[1:]
    result = {"new": False, "status": False, "help": False, "auto": False, "passphrase": None, "repo": REPO_URL_DEFAULT}
    for arg in args:
        if arg.startswith("-new"):
            result["new"] = True
            parts = arg.split(None, 1)
            if len(parts) > 1:
                result["repo"] = parts[1]
        elif arg in ["-status", "-fix"]:
            result["status"] = True
        elif arg == "-auto":
            result["auto"] = True
        elif arg in ["-help", "--help", "-h"]:
            result["help"] = True
    for arg in args:
        if not arg.startswith("-") and not arg.startswith("http"):
            result["passphrase"] = arg
        if arg.startswith("http"):
            result["repo"] = arg
    return result

